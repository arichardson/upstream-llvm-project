; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
;; A minimal test to check that we can load and store capabilities
; RUN: llc < %s -mtriple=riscv32 -mattr=+experimental-y -target-abi=il32pc64 | FileCheck %s --check-prefixes=CHECK,CHECK32
; RUN: llc < %s -mtriple=riscv64 -mattr=+experimental-y -target-abi=l64pc128 | FileCheck %s --check-prefixes=CHECK,CHECK64

define ptr addrspace(200) @load_cap(ptr addrspace(200) %p) nounwind {
; CHECK-LABEL: load_cap:
; CHECK:       # %bb.0:
; CHECK-NEXT:    ly a0, 0(a0)
; CHECK-NEXT:    ret
  %ret = load ptr addrspace(200), ptr addrspace(200) %p, align 16
  ret ptr addrspace(200) %ret
}

define void @store_cap(ptr addrspace(200) %p, ptr addrspace(200) %val) nounwind {
; CHECK-LABEL: store_cap:
; CHECK:       # %bb.0:
; CHECK-NEXT:    sy a1, 0(a0)
; CHECK-NEXT:    ret
  store ptr addrspace(200) %val, ptr addrspace(200) %p, align 16
  ret void
}

declare void @clobber()

define ptr addrspace(200) @spill_cap(ptr addrspace(200) %val) nounwind {
; CHECK32-LABEL: spill_cap:
; CHECK32:       # %bb.0:
; CHECK32-NEXT:    yaddi sp, sp, -16
; CHECK32-NEXT:    sy ra, 8(sp) # 8-byte Folded Spill
; CHECK32-NEXT:    sy s0, 0(sp) # 8-byte Folded Spill
; CHECK32-NEXT:    ymv s0, a0
; CHECK32-NEXT:    call clobber
; CHECK32-NEXT:    ymv a0, s0
; CHECK32-NEXT:    ly ra, 8(sp) # 8-byte Folded Reload
; CHECK32-NEXT:    ly s0, 0(sp) # 8-byte Folded Reload
; CHECK32-NEXT:    yaddi sp, sp, 16
; CHECK32-NEXT:    ret
;
; CHECK64-LABEL: spill_cap:
; CHECK64:       # %bb.0:
; CHECK64-NEXT:    yaddi sp, sp, -32
; CHECK64-NEXT:    sy ra, 16(sp) # 16-byte Folded Spill
; CHECK64-NEXT:    sy s0, 0(sp) # 16-byte Folded Spill
; CHECK64-NEXT:    ymv s0, a0
; CHECK64-NEXT:    call clobber
; CHECK64-NEXT:    ymv a0, s0
; CHECK64-NEXT:    ly ra, 16(sp) # 16-byte Folded Reload
; CHECK64-NEXT:    ly s0, 0(sp) # 16-byte Folded Reload
; CHECK64-NEXT:    yaddi sp, sp, 32
; CHECK64-NEXT:    ret
  call void @clobber()
  ret ptr addrspace(200) %val
}
